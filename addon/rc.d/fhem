#!/bin/sh
# -----------------------------------------------------------------------------
# OpenCCU-Add-on "FHEM" - Startskript (rc.d)
# Aufrufe durch OpenCCU: start | stop | restart | info | uninstall
# -----------------------------------------------------------------------------

ADDON_NAME=fhem
ADDON_DIR=/usr/local/addons/$ADDON_NAME
RCD_FILE=/usr/local/etc/config/rc.d/$ADDON_NAME
WWW_DIR=/usr/local/etc/config/addons/www/$ADDON_NAME

FHEM_HOME=$ADDON_DIR/fhem
FHEM_PERL=$ADDON_DIR/perl/bin/perl
[ -f "$ADDON_DIR/bin/fhem-env.sh" ] && . "$ADDON_DIR/bin/fhem-env.sh"

PIDFILE=$FHEM_HOME/log/fhem.pid
STOP_TIMEOUT=60

find_pid() {
  if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo "$pid"; return 0; fi
  fi
  # Fallback, falls das pidfilename-Attribut entfernt wurde
  ps -o pid,args 2>/dev/null | awk '/[f]hem\.pl fhem\.cfg/ {print $1; exit}'
}

start() {
  pid=$(find_pid)
  if [ -n "$pid" ]; then echo "FHEM laeuft bereits (PID $pid)."; return 0; fi
  [ -x "$FHEM_PERL" ] || { echo "Perl-Laufzeit fehlt: $FHEM_PERL"; return 1; }
  cd "$FHEM_HOME" || return 1
  mkdir -p log
  echo "Starte FHEM ..."
  # fhem.pl geht selbst in den Hintergrund (global nofork = 0)
  "$FHEM_PERL" fhem.pl fhem.cfg >>"$FHEM_HOME/log/fhem-console.log" 2>&1
}

stop() {
  pid=$(find_pid)
  if [ -z "$pid" ]; then echo "FHEM laeuft nicht."; rm -f "$PIDFILE"; return 0; fi
  echo "Stoppe FHEM (PID $pid) ..."
  # SIGTERM -> FHEM faehrt sauber herunter und schreibt die Statusdatei
  kill -TERM "$pid" 2>/dev/null
  i=0
  while kill -0 "$pid" 2>/dev/null && [ $i -lt $STOP_TIMEOUT ]; do
    sleep 1; i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "FHEM reagiert nicht, beende hart."
    kill -KILL "$pid" 2>/dev/null
  fi
  rm -f "$PIDFILE"
}

info() {
  VER=$(cat "$ADDON_DIR/VERSION" 2>/dev/null)
  echo "Info: <b>FHEM</b> - Perl-Server f&uuml;r Hausautomation<br>"
  echo "Info: Weboberfl&auml;che: <a href=\"/addons/fhem/\" target=\"_blank\">http://&lt;CCU-IP&gt;:8083/fhem</a><br>"
  echo "Info: Enth&auml;lt eigene Perl-Laufzeit inkl. XML::Parser, RPC::XML, Net::SSLeay, IO::Socket::SSL, Device::SerialPort"
  echo "Name: FHEM"
  echo "Version: $VER"
  echo "Operations: uninstall restart"
  echo "Config-Url: /addons/fhem/"
}

uninstall() {
  stop
  # Sicherung der wichtigsten FHEM-Dateien vor dem Loeschen
  if [ -d "$FHEM_HOME" ]; then
    BK=/usr/local/fhem-backup-$(date +%Y%m%d-%H%M%S).tar.gz
    ( cd "$FHEM_HOME" && tar czf "$BK" fhem.cfg log/fhem.save FHEM/99_*Utils.pm 2>/dev/null )
    [ -s "$BK" ] && echo "Sicherung der FHEM-Konfiguration: $BK"
  fi
  rm -rf "$ADDON_DIR" "$WWW_DIR"
  rm -f /usr/local/addons/fhem-install.log
  rm -f "$RCD_FILE"
}

case "$1" in
  start)     start ;;
  stop)      stop ;;
  restart)   stop; sleep 2; start ;;
  status)    pid=$(find_pid); if [ -n "$pid" ]; then echo "FHEM laeuft (PID $pid)"; else echo "FHEM laeuft nicht"; exit 1; fi ;;
  info)      info ;;
  uninstall) uninstall ;;
  *)         echo "Aufruf: $0 {start|stop|restart|status|info|uninstall}"; exit 1 ;;
esac
exit 0
